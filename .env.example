# ── Database ──────────────────────────────────────────────
# Local (npm run db:local): postgresql://tripora:tripora@localhost:54329/tripora
DATABASE_URL=

# ── Travelpayouts (server-side only; never prefix with NEXT_PUBLIC_) ──
TRAVELPOUTS_API_TOKEN=
# Numeric affiliate marker/project ID used to attribute clicks
TRAVELPOUTS_PROJECT_ID=
# Optional: White Label search subdomain, e.g. https://search.example.com
TRAVELPOUTS_WHITE_LABEL_URL=

# ── AI (server-side only) ─────────────────────────────────
# Optional. Without it the deterministic itinerary engine is used.
AI_API_KEY=
AI_MODEL=claude-opus-5

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=

# ── Auth ──────────────────────────────────────────────────
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET=
# Comma-separated emails that are granted ADMIN on first sign-up
ADMIN_BOOTSTRAP_EMAILS=

# ── Observability ─────────────────────────────────────────
SENTRY_DSN=
